{
    "name": "devium/toml",
    "version": "1.1.1",
    "description": "A PHP encoder/decoder for TOML compatible with 1.0.0 and 1.1.0",
    "keywords": ["toml", "parser", "encode", "decode"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vano Devium",
            "email": "vano@devium.me"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "symfony/polyfill-mbstring": "^1.30"
    },
    "require-dev": {
        "laravel/pint": "^1.17.3",
        "pestphp/pest": "^3.8.6",
        "phpstan/phpstan": "^2.2.5",
        "rector/rector": "^2.5.3",
        "symfony/var-dumper": "^6.4|^7.1.4"
    },
    "autoload": {
        "psr-4": {
            "Devium\\Toml\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "suggest": {
        "ext-mbstring": "For best performance"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "refacto": "rector",
        "pint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi src",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "test:no-mbstring": [
            "@test:refacto",
            "@test:types",
            "@test:unit"
        ]
    }
}
